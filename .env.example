# 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다.
# .env.local은 .gitignore에 의해 커밋되지 않는다.

# --- Supabase ---
# https://supabase.com/dashboard/project/_/settings/api 에서 확인
# 프로젝트 루트 URL만 넣는다. `/rest/v1` 같은 경로를 붙이면 Auth 호출이 전부 깨진다.
# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CRITICAL: service-role 키는 서버 전용. NEXT_PUBLIC_ 접두어를 절대 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# Vercel AI SDK가 환경변수에서 직접 읽는다(코드에서 참조하지 않음).
ANTHROPIC_API_KEY=
# LLM_FALLBACK_PROVIDER=openai 로 쓸 때만 필요
OPENAI_API_KEY=

# 프로바이더 선택 (미설정 시 primary=anthropic, fallback=openai)
# LLM_PRIMARY_PROVIDER=anthropic
# LLM_FALLBACK_PROVIDER=openai

# --- Polar (구독 결제) ---
# 샌드박스: https://sandbox.polar.sh  (프로덕션 polar.sh와 별도 계정)
# Settings → Developers 에서 발급. CRITICAL: 서버 전용, NEXT_PUBLIC_ 금지.
POLAR_ACCESS_TOKEN=
# 웹훅 엔드포인트 등록 시 직접 정하는 값 (openssl rand -hex 32).
# 대시보드 입력값과 이 값이 일치해야 서명 검증이 통과한다.
POLAR_WEBHOOK_SECRET=
# Products 에서 만든 "finsight Premium" 제품 ID (UUID)
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox
# 체크아웃 성공/취소 리다이렉트 기준 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
